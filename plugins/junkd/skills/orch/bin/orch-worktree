#!/usr/bin/env bash
# orch-worktree — per-task git worktrees under .worktrees/ + stable port slots.
# Zero deps (bash + git). Ports = capability port_base + slot; the slot is printed here,
# the orchestrator/verify-coordinator adds the config port_base (also printed when declared).
# `.worktrees/` goes to .git/info/exclude so it never shows up as untracked.
#   orch-worktree add <id> <branch> [base]  # create/attach the worktree (detached at <branch> when it
#                                           # exists: the implementer's own worktree may still hold it);
#                                           # print dir + slot + ports; symlink the config's
#                                           # `worktree_links` dirs from the main checkout (stderr)
#   orch-worktree remove <id>               # remove the worktree, free its slot
#   orch-worktree slot <id>                 # print (assigning if needed) the slot for <id>
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
# root = the checkout we run in (a project that is itself a worktree keeps its own .orch/; from a task
# worktree, the project's root), orch-state's resolution; the common dir only hosts the shared info/exclude.
git rev-parse --show-toplevel >/dev/null 2>&1 || { echo "orch: not inside a git repo" >&2; exit 2; }
root=$("$here/orch-state" root)
common=$(git rev-parse --path-format=absolute --git-common-dir)
config="$root/.orch/config.md"
[ -f "$config" ] || config="$root/.claude/orch.config.md"
[ -f "$config" ] || { echo "orch: no config - run orch-init" >&2; exit 2; }
wt="$root/.worktrees"; reg="$wt/.orch-slots"     # registry lines: "<id> <slot>"
mkdir -p "$wt" "$common/info"; touch "$reg"
grep -qxF '.worktrees/' "$common/info/exclude" 2>/dev/null || echo '.worktrees/' >> "$common/info/exclude"

# _cap_port_base <web|api> -> port_base int (empty if the capability is not declared)
_cap_port_base(){
  awk -v cap="$1" '
    { sub(/\r$/, "") }
    $0 ~ /^capabilities:/ { inc=1; next }
    inc && $0 ~ /^[^ \t]/ { inc=0 }
    inc && $0 ~ ("^[ \t]+" cap "[ \t]*:") {
      if (match($0, /port_base:[ \t]*[0-9]+/)) { s=substr($0,RSTART,RLENGTH); gsub(/[^0-9]/,"",s); print s; exit }
    }' "$config"
}

# The registry is shared by parallel verify-coordinators (batch): one writer at a time.
_lock(){
  local n=0
  until mkdir "$reg.lock" 2>/dev/null; do
    n=$((n+1)); [ "$n" -le 100 ] || { echo "orch: $reg.lock held for 10s; remove it if no orch-worktree runs" >&2; exit 1; }
    sleep 0.1
  done
  trap 'rmdir "$reg.lock" 2>/dev/null || true' EXIT
}

# Branch and base reach git as arguments: each must be a name git takes for a branch (no option, no -x).
_ref(){
  git check-ref-format --branch "$1" >/dev/null 2>&1 || { echo "orch: bad branch name '$1'" >&2; exit 1; }
  echo "$1"
}

# The config's default_base is never a task branch: nothing is checked out as one.
_not_base(){
  local b; b=$("$here/orch-state" cfg default_base)
  [ -z "$b" ] || [ "$1" != "$b" ] || { echo "orch: '$1' is the default base (config default_base): never a task branch" >&2; exit 1; }
}

# stable slot for an id: reuse the registered one, else claim the lowest free index.
_slot_for(){
  local id="$1" s
  _lock
  s=$(awk -v id="$id" '$1==id{print $2; exit}' "$reg")
  if [ -z "$s" ]; then
    s=0
    while awk -v n="$s" '$2==n{f=1} END{exit !f}' "$reg"; do s=$((s+1)); done
    printf '%s %s\n' "$id" "$s" >> "$reg"
  fi
  echo "$s"
}

# _links <dir>: each config `worktree_links` path (globs allowed) the main checkout has, gitignores and does
# not track, and <dir> lacks, becomes a symlink to the main checkout's copy (+ an info/exclude line: a link
# is no dir to a `node_modules/` rule). A package whose lockfile differs from the main one's is skipped.
_links(){
  local dir="$1" list main pat pats src rel pkg lock
  list=$("$here/orch-state" cfg worktree_links); list=${list#[}; list=${list%]}
  [ -n "${list//[ ,]/}" ] || return 0
  main=$(git -C "$root" worktree list --porcelain | awk 'NR==1{sub(/^worktree /,""); print}')
  [ "$(cd "$main" && pwd -P)" != "$(cd "$dir" && pwd -P)" ] || return 0
  IFS=, read -ra pats <<<"$list"
  for pat in "${pats[@]}"; do
    pat=$(echo "$pat" | sed 's/^[[:space:]"'"'"']*//; s/[[:space:]"'"'"']*$//'); pat=${pat%/}
    case "$pat" in ""|/*|..|../*|*/..|*/../*) [ -z "$pat" ] || echo "orch: worktree_links: skip '$pat' (not a repo path)" >&2; continue ;; esac
    for src in "$main"/$pat; do
      rel=${src#"$main"/}
      [ -d "$src" ] && [ ! -e "$dir/$rel" ] && [ ! -L "$dir/$rel" ] || continue
      if ! git -C "$main" check-ignore -q "$rel" 2>/dev/null; then   # tracked content is never "ignored"
        echo "orch: worktree_links: skip $rel (tracked or not gitignored)" >&2; continue
      fi
      pkg=$(dirname "$rel")
      for lock in package-lock.json npm-shrinkwrap.json yarn.lock pnpm-lock.yaml bun.lock bun.lockb Podfile.lock Gemfile.lock poetry.lock uv.lock; do
        if [ -f "$main/$pkg/$lock" ] && [ -f "$dir/$pkg/$lock" ] && ! cmp -s "$main/$pkg/$lock" "$dir/$pkg/$lock"; then
          echo "orch: worktree_links: skip $rel ($pkg/$lock differs from the main checkout's)" >&2; continue 2
        fi
      done
      mkdir -p "$(dirname "$dir/$rel")"; ln -s "$src" "$dir/$rel"
      grep -qxF "/$rel" "$common/info/exclude" 2>/dev/null || echo "/$rel" >> "$common/info/exclude"
      echo "linked $rel -> $src" >&2
    done
  done
}

cmd="${1:-}"; shift || true
case "$cmd" in
  add)
    id=$("$here/orch-state" id "${1:?usage: orch-worktree add <id> <branch> [base]}")
    branch=$(_ref "${2:?branch required}"); base="${3:-}"; _not_base "$branch"
    if [ -n "$base" ]; then
      base=$(_ref "$base"); [ "$branch" != "$base" ] || { echo "orch: branch and base are both '$base'" >&2; exit 1; }
    fi
    dir="$wt/$id"
    want=$(git -C "$root" rev-parse --verify --quiet "$branch^{commit}" || true)
    if [ -d "$dir" ]; then
      [ -n "$want" ] && [ "$(git -C "$dir" rev-parse HEAD)" = "$want" ] ||
        { echo "orch: $dir is not at $branch; run orch-worktree remove $id first" >&2; exit 1; }
    elif [ -n "$want" ]; then
      # detached: the implementer's own worktree may still have the branch checked out; verify needs the commit only
      git -C "$root" worktree add --detach "$dir" "$branch" >&2
    else
      git -C "$root" worktree add "$dir" -b "$branch" "${base:-HEAD}" >&2
    fi
    _links "$dir"
    slot=$(_slot_for "$id")
    echo "dir=$dir"
    echo "slot=$slot"
    wb=$(_cap_port_base web); if [ -n "$wb" ]; then echo "web_port=$((wb+slot))"; fi
    ab=$(_cap_port_base api); if [ -n "$ab" ]; then echo "api_port=$((ab+slot))"; fi
    ;;
  remove)
    id=$("$here/orch-state" id "${1:?usage: orch-worktree remove <id>}")
    git -C "$root" worktree remove --force "$wt/$id" 2>/dev/null || true
    _lock
    awk -v id="$id" '$1!=id' "$reg" > "$reg.tmp"; mv -f "$reg.tmp" "$reg"
    echo "removed $id"
    ;;
  slot)
    _slot_for "$("$here/orch-state" id "${1:?usage: orch-worktree slot <id>}")"
    ;;
  *) echo "orch-worktree: unknown command '$cmd'" >&2; exit 1;;
esac
