#!/usr/bin/env bash
# Toggle global TL;DR mode by presence of a flag file. Read by the UserPromptSubmit hook (tldr-hook) each turn.
#   tldr-flag on | off | status
# Each host keeps its own flag (host-lib picks the host: JUNK_DRAWER_RUNTIME, else auto-detected; an unknown host
# exits 2 and writes nothing): Claude Code ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/junkd/tldr-on (the junkd hooks module
# spells it the same), Codex and Kimi Code <home>/junk-drawer/tldr-on, OpenCode
# ${XDG_DATA_HOME:-$HOME/.local/share}/opencode/junk-drawer/tldr-on. OpenCode runs no hook: there `on` only records it.
case "$0" in */*) here=${0%/*} ;; *) here=. ;; esac # no dirname: a hook may run with a bare PATH
. "$here/host-lib" || exit 2
jd_host || exit 2
cfg=$JD_FLAGS
flag="$cfg/tldr-on"
case "${1:-status}" in
    on)
        mkdir -p "$cfg" || exit 1
        : > "$flag"
        if [ "$JD_HOST" = opencode ]; then
            echo "TL;DR mode ON (flag recorded; OpenCode runs no hook, so replies are not changed). Use tldr off to stop."
        else
            echo "TL;DR mode ON (all sessions with the plugin). Use tldr off to stop."
        fi
        ;;
    off) rm -f "$flag"; echo "TL;DR mode OFF." ;;
    *)   [ -f "$flag" ] && echo "TL;DR mode: ON" || echo "TL;DR mode: OFF" ;;
esac
